# ─── Stripe ──────────────────────────────────────────────────────────
# Test keys from https://dashboard.stripe.com/test/apikeys
# Flip to live keys (sk_live_…) when you launch — see README checklist.
STRIPE_SECRET_KEY=sk_test_xxx
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` (dev)
# or Dashboard → Developers → Webhooks (prod)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ─── Automation handoff ─────────────────────────────────────────────
# Your n8n endpoint. On payment, the full briefing is POSTed here as JSON:
# { event, product, orderId, amountTotal, currency, briefing{…}, bump, utm{…} }
AUTOMATION_WEBHOOK_URL=https://your-n8n-instance.com/webhook/tuneofus

# ─── Kie.ai (Suno) — direct generation ──────────────────────────────
# If AUTOMATION_WEBHOOK_URL is empty and this is set, the site generates
# the song itself after payment (POST api.kie.ai/api/v1/generate) and
# logs finished track URLs at /api/kie/callback. Also powers
# /api/generate-song for testing.
KIE_API_KEY=your_kie_key
# Suno model: V3_5 | V4 | V4_5 | V4_5PLUS | V4_5ALL | V5 | V5_5
KIE_SUNO_MODEL=V5

# ─── Email delivery (Resend) ────────────────────────────────────────
# When KIE_API_KEY is used (no n8n), the site emails the buyer: an
# instant confirmation on payment + the finished song when it renders.
RESEND_API_KEY=re_xxx
# MUST be an address on a domain you've verified at resend.com/domains.
# Until verified, Resend only delivers to the account owner's inbox.
EMAIL_FROM=TuneOfUs <hello@tuneofus.com>

# ─── Meta tracking ───────────────────────────────────────────────────
# Pixel ID. Events Manager → Data sources → your pixel (the number under
# the name). Used by the browser pixel AND as the CAPI dataset id.
NEXT_PUBLIC_META_PIXEL_ID=2240086196844764

# Conversions API access token — SERVER ONLY, never prefixed NEXT_PUBLIC.
# Events Manager → your pixel → Settings → Conversions API →
# "Generate access token". Sends the server-side Purchase.
META_CAPI_ACCESS_TOKEN=

# Optional. Events Manager → Test Events → copy the TEST#### code. While
# set, Purchase events go to the Test Events panel instead of production.
# MUST be empty in production.
META_CAPI_TEST_EVENT_CODE=

# Optional. Events Manager → Settings → Verify Domain → meta-tag method:
# paste only the content value (not the whole tag).
NEXT_PUBLIC_FB_DOMAIN_VERIFICATION=

# Microsoft Clarity project id (clarity.microsoft.com → Settings → Overview)
NEXT_PUBLIC_CLARITY_ID=xr8hkijydq

# ─── Site config ─────────────────────────────────────────────────────
# Price in whole dollars. Unset = 19 (the real price). Set to 1 only for a
# cheap end-to-end tracking test, together with META_CAPI_TEST_EVENT_CODE
# so the $1 Purchase lands in Test Events and never pollutes the pixel's
# production value data. Restore (delete the var) right after the test.
NEXT_PUBLIC_PRICE_USD=
NEXT_PUBLIC_SITE_URL=https://tuneofus.com
# Social-proof counter in the hero eyebrow
NEXT_PUBLIC_TEARS_COUNT=12,000+
# "Launch price — ends soon" pill. Flag only — never a fake countdown.
NEXT_PUBLIC_SHOW_URGENCY=true
